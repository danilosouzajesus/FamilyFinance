# ===== Supabase (cliente do frontend) =====
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ===== Supabase (servidor — persiste o estado do Pluggy e os dados da app) =====
# Necessário em dev e produção: as pendências e conexões do Pluggy
# são gravadas nas tabelas pending_transactions e pluggy_connections.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Pluggy (Open Finance) =====
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Obrigatório em produção (HTTPS). Em localhost http ele é omitido.
PLUGGY_WEBHOOK_URL=https://SEU-DOMINIO.vercel.app/api/pluggy/webhook
# Em dev (npm run dev) o conector Sandbox da Pluggy é habilitado por padrão no widget.
# No build de produção o sandbox fica desativado; defina "true" aqui para forçá-lo.
# Credenciais do Sandbox: usuário "user-ok", senha "password-ok", MFA "123456".
VITE_PLUGGY_ENABLE_SANDBOX=true

# ===== Gemini (Conselheiro IA) =====
GEMINI_API_KEY=

# ===== Geral =====
APP_URL=http://localhost:3000