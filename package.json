{
  "name": "familyfinance",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w @ff/server",
    "build": "npm run build -w @ff/client && npm run build -w @ff/server && node scripts/ensure-build-dirs.js",
    "start": "npm run start -w @ff/server",
    "clean": "rm -rf dist client/dist server/dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node scripts/pluggy-integration.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.3",
    "jsdom": "^30.0.1",
    "typescript": "~5.8.2",
    "vitest": "^4.1.10"
  }
}
